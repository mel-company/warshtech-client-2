# Backend API (must include /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Lock login to one workshop (subdomain). Leave empty to show editable tenant field.
# A host like demo.localhost overrides this.
NEXT_PUBLIC_FIXED_TENANT=
# Production apex, so settings can show demo.example.com. Empty uses subdomain.localhost.
NEXT_PUBLIC_ROOT_DOMAIN=
